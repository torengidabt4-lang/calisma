<Window x:Class="Ekran.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Ekran - Uzaktan Masaüstü" Height="600" Width="900"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Başlık Bar -->
        <StackPanel Grid.Row="0" Background="#2196F3" Orientation="Horizontal" Height="60" VerticalAlignment="Center">
            <TextBlock Text="Ekran Paylaşım" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- Ana İçerik -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <!-- Ekran Görünümü -->
            <Border Grid.Column="0" Background="Black" CornerRadius="8" Margin="0,0,10,0">
                <Image x:Name="ScreenImage" Stretch="UniformToFill"/>
            </Border>

            <!-- Kontrol Paneli -->
            <Border Grid.Column="1" Background="White" CornerRadius="8" Margin="0,0,0,0">
                <StackPanel Padding="15" VerticalAlignment="Top">
                    <TextBlock Text="Kontroller" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#212121"/>

                    <Button Content="Ekran Güncelle" Click="UpdateScreen_Click" 
                            Background="#2196F3" Foreground="White" Padding="10" Margin="0,5" Height="40" FontSize="12" FontWeight="Bold"/>

                    <Button Content="Mouse Test" Click="MouseTest_Click" 
                            Background="#FF9800" Foreground="White" Padding="10" Margin="0,5" Height="40" FontSize="12" FontWeight="Bold"/>

                    <Button Content="Klavye Test" Click="KeyboardTest_Click" 
                            Background="#4CAF50" Foreground="White" Padding="10" Margin="0,5" Height="40" FontSize="12" FontWeight="Bold"/>

                    <Button Content="Kapat" Click="Close_Click" 
                            Background="#F44336" Foreground="White" Padding="10" Margin="0,5" Height="40" FontSize="12" FontWeight="Bold"/>

                    <TextBlock Text="" x:Name="StatusText" Margin="0,15,0,0" FontSize="11" Foreground="#666666" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Alt Bar -->
        <StatusBar Grid.Row="2" Background="#E0E0E0" Height="30">
            <TextBlock x:Name="StatusBar" Text="Hazır" Foreground="#212121" Margin="10,0"/>
        </StatusBar>
    </Grid>
</Window>