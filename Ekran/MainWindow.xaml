<Window x:Class="Ekran.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ekran - Uzaktan Masaüstü" Height="600" Width="900"
        Background="#F5F5F5"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Background="#2196F3" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Text="Ekran Paylas Im" Foreground="White" FontSize="24" FontWeight="Bold" Margin="20,0"/>
        </StackPanel>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="Black" BorderBrush="#CCCCCC" BorderThickness="1">
                <Image x:Name="ScreenImage" Stretch="UniformToFill"/>
            </Border>

            <Border Grid.Column="1" Background="White" BorderBrush="#CCCCCC" BorderThickness="1" Margin="10,0,0,0">
                <StackPanel Margin="15">
                    <TextBlock Text="Kontroller" FontSize="16" FontWeight="Bold" Margin="0,0,0,15" Foreground="#333333"/>

                    <Button Content="Ekran Guncelle" Click="UpdateScreen_Click" 
                            Background="#2196F3" Foreground="White" Padding="10" Margin="0,5" Height="40" FontSize="12"/>

                    <Button Content="Mouse Test" Click="MouseTest_Click" 
                            Background="#FF9800" Foreground="White" Padding="10" Margin="0,5" Height="40" FontSize="12"/>

                    <Button Content="Klavye Test" Click="KeyboardTest_Click" 
                            Background="#4CAF50" Foreground="White" Padding="10" Margin="0,5" Height="40" FontSize="12"/>

                    <Button Content="Kapat" Click="Close_Click" 
                            Background="#F44336" Foreground="White" Padding="10" Margin="0,5" Height="40" FontSize="12"/>

                    <TextBlock x:Name="StatusText" Margin="0,15,0,0" FontSize="11" Foreground="#666666" TextWrapping="Wrap" Text="Hazir"/>
                </StackPanel>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="#E0E0E0">
            <TextBlock x:Name="StatusBar" Text="Basarili" Foreground="#333333" Margin="10,0"/>
        </StatusBar>
    </Grid>
</Window>
